NODE_ENV=development
PORT=3001
# Mínimo 32 caracteres en producción. Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Orígenes permitidos para CORS separados por coma (vacío = sólo mismo origen / proxy)
CORS_ORIGINS=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=qralbum

# API PHP legada donde viven los archivos antiguos
LEGACY_MEDIA_API_URL=https://apimultimedia.mcsolucionesti.com/index.php
