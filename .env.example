NODE_ENV=development
PORT=3001
# Mínimo 32 caracteres en producción. Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Orígenes permitidos para CORS separados por coma (vacío = sólo mismo origen / proxy)
CORS_ORIGINS=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=qralbum

# Dónde se guardan fotos, audio y video procesados: local (disco) o s3 (bucket)
STORAGE_DRIVER=local
# local: carpeta (por defecto ./storage)
STORAGE_DIR=
# s3: bucket S3 compatible (Railway Buckets, Cloudflare R2, AWS). Bucket privado: /media redirige a URLs firmadas.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Carpeta dentro del bucket (por defecto media)
S3_PREFIX=

# Carpeta de plantillas del frontend (por defecto ../qralbumfront/src/templates)
TEMPLATES_ROOT=
# gift-core compartido (por defecto ../qralbumfront/gift-core/index.js)
GIFT_CORE_PATH=

# Producción: dominio público (links, og:image) y servir el build del frontend
PUBLIC_URL=
SERVE_WEB=
WEB_DIST_DIR=
FORCE_HTTPS=
# Secreto de links del portal (por defecto derivado de JWT_SECRET)
PORTAL_TOKEN_SECRET=

# ── Producción en un solo servicio (Railway) ─────────────────────────────
# `npm run build` descarga qralbumfront en ./web y lo compila. Ver docs/DEPLOY.md
# TEMPLATES_ROOT=web/src/templates
# GIFT_CORE_PATH=web/gift-core/index.js
# WEB_DIST_DIR=web/dist
# WEB_REPO=jampierzcode/qralbumfront
# WEB_REF=main
# GITHUB_TOKEN=                (sólo si qralbumfront es privado)
